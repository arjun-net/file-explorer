{
  "name": "file-explorer",
  "productName": "Files",
  "description": "A fast, native-feeling desktop file explorer built with Electron and React.",
  "author": "arjun2",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c auto \"vite\" \"npm:electron:dev\"",
    "electron:dev": "node scripts/build-electron.mjs && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@huggingface/transformers": "^4.3.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.46.0",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ffmpeg-static": "^3.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.localfirst.files",
    "productName": "Files",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true,
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
